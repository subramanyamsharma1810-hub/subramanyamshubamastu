# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ZEPTOMAIL_API_TOKEN: ZeptoMail API Token for sending transactional emails (used by SendMailClient)
ZEPTOMAIL_API_TOKEN="Zoho-enczapikey PHtE6r0PS7y6iDQp+xNWtPPqFpbwZI8r+L82eAFA4YoTXqdRSU1crtwqkD6xoxspU6QXFqSbyd1hseybtLiAdm/tND0ZVGqyqK3sx/VYSPOZsbq6x00ZtFgTdkbbU4TsdtNq1ibTut/bNA=="

# ZOHO_ZEPTOMAIL_API_KEY: Zoho ZeptoMail Send Mail API key (Zoho-enczapikey)
ZOHO_ZEPTOMAIL_API_KEY="PHtE6r0PS7y6iDQp+xNWtPPqFpbwZI8r+L82eAFA4YoTXqdRSU1crtwqkD6xoxspU6QXFqSbyd1hseybtLiAdm/tND0ZVGqyqK3sx/VYSPOZsbq6x00ZtFgTdkbbU4TsdtNq1ibTut/bNA=="

# ZOHO_SENDER_EMAIL: Sender address verified in your ZeptoMail Agent
ZOHO_SENDER_EMAIL="verification@shubhamastu.in"

# ZOHO_SENDER_NAME: Display name for sent transactional emails
ZOHO_SENDER_NAME="shubhamastu.in"

# AGORA_APP_ID: Agora.io App ID for Live Audio & Video Calls
AGORA_APP_ID="58b929a373224fd693defde48656648b"

# AGORA_APP_CERTIFICATE: Agora.io Primary Certificate for secure token generation
AGORA_APP_CERTIFICATE="906f53f47a0247e394fd3ca70cb29ce9"

