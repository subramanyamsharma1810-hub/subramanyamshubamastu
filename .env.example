# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ZEPTOMAIL_API_TOKEN: ZeptoMail API Token for sending transactional emails (used by SendMailClient)
ZEPTOMAIL_API_TOKEN="your_zeptomail_api_token_here"

# ZOHO_ZEPTOMAIL_API_KEY: Zoho ZeptoMail Send Mail API key
ZOHO_ZEPTOMAIL_API_KEY="your_zoho_zeptomail_api_key_here"

# ZOHO_SENDER_EMAIL: Sender address verified in your ZeptoMail Agent
ZOHO_SENDER_EMAIL="verification@shubhamastu.in"

# ZOHO_SENDER_NAME: Display name for sent transactional emails
ZOHO_SENDER_NAME="shubhamastu.in"

# AGORA_APP_ID: Agora.io App ID for Live Audio & Video Calls
AGORA_APP_ID="your_agora_app_id_here"

# AGORA_APP_CERTIFICATE: Agora.io Primary Certificate for secure token generation
AGORA_APP_CERTIFICATE="your_agora_app_certificate_here"

# CLOUDFLARE_R2_ACCESS_KEY_ID: Cloudflare R2 Access Key ID for call recordings
CLOUDFLARE_R2_ACCESS_KEY_ID="your_cloudflare_r2_access_key_id"

# CLOUDFLARE_R2_SECRET_ACCESS_KEY: Cloudflare R2 Secret Access Key for call recordings
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_cloudflare_r2_secret_access_key"

# CLOUDFLARE_R2_ENDPOINT: S3 compatible endpoint for R2 bucket
CLOUDFLARE_R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"

# CLOUDFLARE_R2_BUCKET_NAME: R2 Bucket Name
CLOUDFLARE_R2_BUCKET_NAME="shubhamastu-call-recordings"

# CLOUDFLARE_ACCOUNT_ID: Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_BASE_URL="https://sandbox.cashfree.com/pg"

# PhonePe Production Webhook Configuration
# Set these only in Vercel Production environment settings.
PHONEPE_WEBHOOK_CHECKSUM_KEY="your_phonepe_webhook_checksum_secret"
PHONEPE_PAYMENT_SUCCESS_WEBHOOK_ID="9969b680-79cc-42f9-a18b-33c3d90d2c19"
PHONEPE_PAYMENT_FAILURE_WEBHOOK_ID="9969b680-79cc-42f9-a18b-33c3d90d2c19"
PHONEPE_MERCHANT_ID="your_phonepe_merchant_id"
PHONEPE_CLIENT_ID="your_phonepe_client_id"
PHONEPE_CLIENT_SECRET="your_phonepe_client_secret"
