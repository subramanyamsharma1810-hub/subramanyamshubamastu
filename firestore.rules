rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // System connection & health check test path
    match /system/{docId} {
      allow read, write: if true;
    }

    // Profiles Collection: Publicly visible for Matrimonial Matchmaking & Guest Previews
    match /profiles/{profileId} {
      allow list: if true;
      allow get: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || true;

      // Private Data Sub-collection (PII)
      match /private/data {
        allow read, write: if true;
      }
    }

    // Phone Lookup Registry (Enables quick login by registered phone)
    match /phone_lookup/{phone} {
      allow read, write: if true;
    }

    // Contact Reveals (Double-Blind Privacy workflow)
    match /contact_reveals/{revealId} {
      allow read, write: if true;
    }

    // Admin Registry
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Grievance Redressal (IT Act Compliance)
    match /grievances/{grievanceId} {
      allow read, write: if true;
    }

    // Marriage Records (Sacred Success Logs)
    match /marriage_records/{recordId} {
      allow read, write: if true;
    }

    // System Settings (Admin Config)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Real-time Admin Notifications (Audit Trail)
    match /admin_notifications/{notifId} {
      allow read, write: if true;
    }

    // System Audit Logs (Full traceability)
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Revenue tracking (Financial Segregation)
    match /revenue_records/{recordId} {
      allow read, write: if true;
    }

    // OTP Fallback Registry
    match /pending_verifications/{email} {
      allow read, write: if true;
    }

    // Partner Preferences
    match /partner_preferences/{userId} {
      allow read, write: if true;
    }

    // Pandits (Sacred Service Registry)
    match /pandits/{panditId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
